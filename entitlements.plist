<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Notarisation requires the hardened runtime, and the hardened runtime
       breaks CPython unless these three are granted. Python generates and
       runs code at runtime (that is what an interpreter is), which the
       runtime otherwise treats as exactly the thing it exists to stop. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- PyInstaller ships dozens of .dylib and .so files that are signed with
       our identity rather than Apple's. Without this the loader refuses
       them and the app dies on launch with no useful message. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
</dict>
</plist>
